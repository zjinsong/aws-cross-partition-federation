{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenySourcePartition",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:FederatedProvider": "arn:aws-cn:iam::*:oidc-provider/*.tokens.sts.global.api.aws"
        }
      }
    }
  ]
}
