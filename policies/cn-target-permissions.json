{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTestBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws-cn:s3:::${CN_BUCKET}"
    },
    {
      "Sid": "ReadWriteTestObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws-cn:s3:::${CN_BUCKET}/*"
    }
  ]
}
