# 复制为 config.env 后填写。config.env 已在 .gitignore 中，不会提交。

# ---- 中国区账号 ----
CN_PROFILE=ChinaCredentials
CN_REGION=cn-northwest-1
CN_ACCOUNT_ID=111122223333
# 允许 assume CrossPartitionCaller 的 IAM 身份（演示用）。生产环境改为服务主体
CN_CALLER_PRINCIPAL=arn:aws-cn:iam::111122223333:user/your-cli-user

# ---- Global 账号 ----
GL_PROFILE=GlobalCredentials
GL_REGION=us-east-1
GL_ACCOUNT_ID=444455556666
GL_CALLER_PRINCIPAL=arn:aws:iam::444455556666:user/your-cli-user

# ---- 公共参数 ----
AUDIENCE=cross-partition-test
TOKEN_DURATION=300
CALLER_ROLE=CrossPartitionCaller
TARGET_ROLE=CrossPartitionTarget
# 中国区测试存储桶，方向 1 的访问目标
CN_BUCKET=cross-partition-test-111122223333
# 负向用例使用的另一个 Global 区域，与 GL_REGION 不同
GL_OTHER_REGION=us-west-2

# ---- 以下两个值由 01-setup.sh 写入 config.env，无需手动填写 ----
# CN_ISSUER_HOST=<cn-issuer-id>.tokens.sts.global.api.amazonwebservices.com.cn
# GL_ISSUER_HOST=<global-issuer-id>.tokens.sts.global.api.aws
